# Kodi backend — copy to .env or /etc/kodi/backend.env (never commit secrets)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BRAVE_API_KEY=

# Gemini Live (interactive voice brain). Required for the /v1/live WebSocket path.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Puck

# Claude (spec: claude-sonnet-4-6) — background brain: briefing + scheduled tasks
ANTHROPIC_MODEL=claude-sonnet-4-6

# Qdrant (docker compose in infra/)
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=kodi_memories

# Mem0 uses OpenAI for default embedder / internal LLM unless you change config in app/memory.py
MEM0_USER_ID_DEFAULT=kodi_device

# Search cache (SQLite path on server)
SEARCH_CACHE_PATH=./data/search_cache.db

# REQUIRED as the X-Kodi-Setup-Token header on POST /v1/devices/register.
# Registration is never open. Leave this blank and the backend generates a token on
# first boot, stores it in data/setup_token.txt, and logs it once at WARNING.
KODI_SETUP_TOKEN=

# If set, device API secrets in data/devices.json are encrypted at rest (Fernet, derived from this string).
# Use a long random value in production. Plaintext legacy rows still work until re-registered.
KODI_MASTER_SECRET=

# Max POST /v1/devices/register per client IP per rolling hour (0 = no limit)
REGISTER_RATE_LIMIT_PER_HOUR=20

# Agent limits (tune for your latency budget)
TOOL_TIMEOUT_SECONDS=10.0
LLM_TIMEOUT_SECONDS=15.0
# Tools one command may use before the agent gives up. The multi-step UI flow the system
# prompt asks for (open_app -> describe_screen -> tap -> type -> tap send) needs at least 6.
MAX_TOOLS_PER_COMMAND=10
# Prior user/assistant text turns carried across commands in a session.
MAX_HISTORY_MESSAGES=6

# Logging. Output is JSON lines carrying request_id / device_id / turn_id.
# Per-turn traces (provider, model, tokens, tool calls, latency) are appended to
# data/traces/<date>.jsonl and pruned after LOG_RETENTION_DAYS.
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
# Include the user's words and the assistant's reply in traces. Off by default;
# the eval harness turns it on against synthetic data.
TRACE_INCLUDE_TEXT=false

# Home Assistant control actuates hardware using these server-wide credentials, so it is
# NOT implied by pairing a device. Set true to grant it to devices at registration time,
# or add "home_assistant" to a device's grants in data/devices.json.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_AUTO_GRANT=false
