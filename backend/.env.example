# Kodi backend — copy to .env or /etc/kodi/backend.env (never commit secrets)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BRAVE_API_KEY=

# Claude (spec: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Qdrant (docker compose in infra/)
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=kodi_memories

# Mem0 uses OpenAI for default embedder / internal LLM unless you change config in app/memory.py
MEM0_USER_ID_DEFAULT=kodi_device

# Search cache (SQLite path on server)
SEARCH_CACHE_PATH=./data/search_cache.db

# Optional: require this header value for POST /v1/devices/register
KODI_SETUP_TOKEN=

# HMAC registration (optional override; default generated on first run — see app/devices_store.py)
KODI_MASTER_SECRET=

# Logging
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
